# Copy to .env and fill in ONE provider. .env is gitignored; real env vars override it.
# With no key set, DocPilot runs offline (hashing embeddings + extractive answers).

# --- Pick a provider -------------------------------------------------------
# auto (default) = the first provider below whose key is set.
# Or name one: openai | gemini | anthropic | openrouter | groq | deepseek |
#              together | mistral | ollama | lmstudio | custom | none
LLM_PROVIDER=auto

# --- Provider keys (set the one you use) ------------------------------------
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...            # Google AI Studio key (GOOGLE_API_KEY also works)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...
# GROQ_API_KEY=gsk_...
# DEEPSEEK_API_KEY=...
# TOGETHER_API_KEY=...
# MISTRAL_API_KEY=...

# Or one generic key for whichever LLM_PROVIDER you named:
# LLM_API_KEY=...

# --- Model (optional; each provider has a default) --------------------------
# LLM_MODEL=gemini-2.5-flash        # gemini default
# LLM_MODEL=openai/gpt-4o-mini      # openrouter default; any OpenRouter model id works
# LLM_TIMEOUT=30

# --- Any other OpenAI-compatible server -------------------------------------
# LLM_PROVIDER=custom
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=my-model

# --- Embeddings (optional) --------------------------------------------------
# auto = OpenAI embeddings when OPENAI_API_KEY is set, otherwise offline hashing.
# Other providers are opt-in. Changing this changes every stored vector, so
# re-ingest (and use a fresh pgvector table) after switching.
# EMBEDDING_PROVIDER=gemini         # hashing | openai | gemini | mistral | ollama
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIM=384                 # mistral-embed needs 1024, nomic-embed-text 768
